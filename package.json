{
  "name": "agentic-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.0.0 <13.0.0"
  },
  "scripts": {
    "check:docs": "node scripts/engineering/check-docs.mjs",
    "check:workspace": "node scripts/engineering/check-workspace.mjs",
    "dev": "pnpm run build && pnpm --filter @agentic-workbench/api dev",
    "build": "pnpm --filter @agentic-workbench/contracts build && pnpm --filter @agentic-workbench/web build && pnpm --filter @agentic-workbench/api build",
    "typecheck": "pnpm --filter @agentic-workbench/contracts build && pnpm -r typecheck",
    "lint": "eslint apps/api/src apps/web/src packages/contracts/src",
    "test": "pnpm -r test",
    "verify": "pnpm run check:docs && pnpm run check:workspace",
    "new:requirement": "node scripts/engineering/new-document.mjs requirement",
    "new:adr": "node scripts/engineering/new-document.mjs adr",
    "new:plan": "node scripts/engineering/new-document.mjs plan"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
